<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- ====================================================== -->
    <!-- Header                                                  -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:background="@color/color_primary"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.App.Header.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/txtTitle"
            style="@style/Widget.App.Header.Title"
            android:text="Activity Name" />

        <ImageButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.App.Header.IconButton"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh" />

    </LinearLayout>

    <!-- ====================================================== -->
    <!-- Scrollable Content                                      -->
    <!-- ====================================================== -->

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/buttonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================== -->
            <!-- Scanner Card                                    -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialScannerCard"
                style="@style/Widget.App.Card.Outlined"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="18dp">

                    <TextView
                        style="@style/TextAppearance.App.TitleMedium"
                        android:text="Scan Material Code"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/scannerMaterialLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Scan Material Code"
                        style="@style/Widget.App.TextInput.Scanner">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/scannedMaterialCodeInput"
                            android:inputType="text"
                            android:imeOptions="actionDone"
                            style="@style/Widget.App.TextInputEditText" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/totalScanned"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:text="Total Scanned: 0" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/removeCheckbox"
                            style="@style/Widget.App.CheckBox.Remove" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/scannedResultTextView"
                        style="@style/TextAppearance.App.ScannedResult"
                        android:text="Scanned Code will appear here" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- Status / Result Card                            -->
            <!-- In code, swap BOTH together based on result:    -->
            <!--   Success: style Widget.App.Card.Status.Success -->
            <!--            + resultIcon src ic_check_circle      -->
            <!--   Error:   style Widget.App.Card.Status.Error    -->
            <!--            + resultIcon src ic_error_circle       -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultCard"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/Widget.App.Card.Status"
                android:layout_marginHorizontal="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/resultIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/white"
                        android:contentDescription="Status icon" />

                    <TextView
                        android:id="@+id/resultText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.App.StatusResult"
                        android:textAlignment="viewStart"
                        android:gravity="start|center_vertical"
                        android:text="Valid material scanned" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- Material Details Card                           -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialDetailsCard"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/Widget.App.Card.Outlined"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.App.TitleMedium"
                        android:text="Material Details"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:text="Item Code: " />

                        <TextView
                            android:id="@+id/itemCodeValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/TextAppearance.App.BodyMedium"
                            android:text="Item Code Value" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:text="Item Desc: " />

                        <TextView
                            android:id="@+id/itemDescValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/TextAppearance.App.BodyMedium"
                            android:text="Item Description Value" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:text="Quantity: " />

                            <TextView
                                android:id="@+id/itemQtyValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TextAppearance.App.BodyMedium"
                                android:text="0.0" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:text="Batch Qty: " />

                            <TextView
                                android:id="@+id/batchQtyValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TextAppearance.App.BodyMedium"
                                android:text="0.0" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- Table Card                                      -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tableLayoutCard"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/Widget.App.Card.Outlined"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.App.TitleMedium"
                        android:text="Scanned Material Table"
                        android:layout_marginTop="16dp"
                        android:layout_marginHorizontal="16dp"
                        android:textAlignment="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/border_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/totalScannedMaterial"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAlignment="textStart"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:text="Total Material: 0" />

                        <TextView
                            android:id="@+id/totalScannedQty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAlignment="textEnd"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:text="Total Quantity: 0.0" />

                    </LinearLayout>

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:layout_marginHorizontal="5dp"
                        android:maxHeight="320dp">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TableLayout
                                android:id="@+id/tableLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:stretchColumns="*">

                                <!-- Header Row -->
                                <TableRow
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@color/table_header_background">

                                    <TextView
                                        style="@style/TextAppearance.App.LabelLarge"
                                        android:text="Sr.No."
                                        android:textAlignment="center"
                                        android:textColor="@color/table_header_text"
                                        android:background="@drawable/table_cell_border" />

                                    <TextView
                                        style="@style/TextAppearance.App.LabelLarge"
                                        android:text="Serial No."
                                        android:textAlignment="center"
                                        android:textColor="@color/table_header_text"
                                        android:background="@drawable/table_cell_border" />

                                    <TextView
                                        style="@style/TextAppearance.App.LabelLarge"
                                        android:text="Item Code"
                                        android:textAlignment="center"
                                        android:textColor="@color/table_header_text"
                                        android:background="@drawable/table_cell_border" />

                                    <TextView
                                        style="@style/TextAppearance.App.LabelLarge"
                                        android:text="Item Description"
                                        android:textAlignment="center"
                                        android:textColor="@color/table_header_text"
                                        android:background="@drawable/table_cell_border" />

                                    <TextView
                                        style="@style/TextAppearance.App.LabelLarge"
                                        android:text="Quantity"
                                        android:textAlignment="center"
                                        android:textColor="@color/table_header_text"
                                        android:background="@drawable/table_cell_border" />

                                    <TextView
                                        style="@style/TextAppearance.App.LabelLarge"
                                        android:text="Batch Qty"
                                        android:textAlignment="center"
                                        android:textColor="@color/table_header_text"
                                        android:background="@drawable/table_cell_border" />

                                </TableRow>

                                <!-- Data rows: inflate dynamically in code.        -->
                                <!-- Alternate row backgrounds using                -->
                                <!-- @drawable/table_row_even_background and        -->
                                <!-- @drawable/table_row_odd_background for         -->
                                <!-- zebra-striping instead of cell borders.        -->

                            </TableLayout>

                        </HorizontalScrollView>

                    </androidx.core.widget.NestedScrollView>

                    <!-- ========================================== -->
                    <!-- Pagination                                  -->
                    <!-- ========================================== -->

                    <LinearLayout
                        android:id="@+id/paginationContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:layout_marginHorizontal="5dp"
                        android:layout_marginBottom="12dp"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="10dp"
                        android:elevation="1dp"
                        android:background="@drawable/pagination_background">

                        <ImageView
                            android:id="@+id/previousIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_previous"
                            android:contentDescription="Previous page"
                            android:background="@drawable/pagination_icon_disable"
                            app:tint="@color/pagination_idle_icon"
                            android:clickable="false" />

                        <TextView
                            android:id="@+id/pageNumbers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 / 1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="14dp" />

                        <ImageView
                            android:id="@+id/nextIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_next"
                            android:contentDescription="Next page"
                            android:background="@drawable/pagination_icon_enable"
                            app:tint="@color/pagination_active_icon"
                            android:clickable="true" />

                        <Spinner
                            android:id="@+id/rowsPerPageSpinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:minWidth="64dp"
                            android:padding="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- ====================================================== -->
    <!-- Bottom Action Bar                                       -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:orientation="horizontal"
        android:background="@color/card_background"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Widget.App.Button.Disabled"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Submit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Widget.App.Button.Outlined"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Clear" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>