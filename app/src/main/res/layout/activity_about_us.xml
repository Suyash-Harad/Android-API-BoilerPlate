<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".AboutUsActivity">

    <!-- ====================================================== -->
    <!-- Header                                                 -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:background="@color/color_primary"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.App.Header.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/txtTitle"
            style="@style/Widget.App.Header.Title"
            android:text="About Us" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Company Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.App.Card.Elevated"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/color_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/white">

                            <ImageView
                                android:id="@+id/iv_company_logo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/company_logo"
                                android:layout_margin="5dp"
                                android:padding="2dp"
                                android:src="@drawable/bartech_logo" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_company_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/company_name"
                        android:textColor="@color/color_on_primary"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge" />

                    <TextView
                        android:id="@+id/tv_company_tagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/company_tagline"
                        android:textColor="@color/color_on_primary"
                        android:textAppearance="@style/TextAppearance.App.TitleSmall"
                        android:gravity="center" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.App.Card.ElevatedOutlined"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Company Info:"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_about_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/about_description"
                        android:textColor="@color/on_surface_variant"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Our Mission Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.App.Card.ElevatedOutlined"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/our_mission"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_mission_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/mission_description"
                        android:textColor="@color/on_surface_variant"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Information Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                style="@style/Widget.App.Card.ElevatedOutlined">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_information"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:layout_marginBottom="12dp" />

                    <!-- Address 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@string/address_icon"
                            android:src="@drawable/ic_location"
                            app:tint="@color/error" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/address1_title"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                            <TextView
                                android:id="@+id/tv_address1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/address1_text"
                                android:textColor="@color/on_surface_variant"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Address 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@string/address_icon"
                            android:src="@drawable/ic_location"
                            app:tint="@color/error" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/address2_title"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                            <TextView
                                android:id="@+id/tv_address2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/address2_text"
                                android:textColor="@color/on_surface_variant"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@string/phone_icon"
                            android:src="@drawable/ic_phone_outline"
                            app:tint="@color/success" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/phone_title"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                            <TextView
                                android:id="@+id/tv_phone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/phone_text"
                                android:textColor="@color/on_surface_variant"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@string/email_icon"
                            android:src="@drawable/ic_email_outline"
                            app:tint="@color/warning" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/email_title"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                            <TextView
                                android:id="@+id/tv_email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/email_text"
                                android:textColor="@color/on_surface_variant"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Website -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@string/website_icon"
                            android:src="@drawable/ic_web"
                            app:tint="@color/info" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/website_title"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                            <TextView
                                android:id="@+id/tv_website"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/website_text"
                                android:textColor="@color/on_surface_variant"
                                android:textAppearance="@style/TextAppearance.App.BodySmall" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Social Media Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.App.Card.ElevatedOutlined">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/follow_us"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_linkedin"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="20dp"
                            android:contentDescription="@string/linkedin"
                            android:src="@drawable/ic_linkedin" />

                        <ImageView
                            android:id="@+id/iv_youtube"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/youtube"
                            android:src="@drawable/ic_youtube" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>